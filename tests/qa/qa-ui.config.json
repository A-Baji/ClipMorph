{
  "viewports": [[1920, 1080], [1366, 768], [1024, 768], [375, 812], [812, 375]],
  "axeViewport": 1366,
  "states": [
    {
      "name": "board",
      "scenario": "states",
      "ready": ".board article.card .card-main",
      "crops": [".jobs-head", "article.card"]
    },
    {
      "name": "failed-status-mix",
      "scenario": "states",
      "ready": ".column-full .jcard",
      "actions": [
        { "click": "section.column[aria-label='Failed'] .column-head" },
        { "wait": 400 }
      ],
      "crops": [".jobs-head", ".column-full"]
    },
    {
      "name": "running-card-spinner",
      "scenario": "states",
      "promote": true,
      "ready": ".card-actions [role='status'][aria-label='Processing Status fixture: running']",
      "crops": [".jobs-head", "article.card:has-text('Status fixture: running')"]
    },
    {
      "name": "long-content",
      "scenario": "long",
      "ready": ".board article.card .card-main",
      "crops": [".jobs-head", "article.card"]
    },
    {
      "name": "large-board",
      "scenario": "large",
      "ready": ".board article.card .card-main",
      "crops": [".jobs-head", "section.column[aria-label='Failed']"]
    },
    {
      "name": "large-failed-grid",
      "scenario": "large",
      "ready": ".column-full .jcard",
      "actions": [
        { "click": "section.column[aria-label='Failed'] .column-head" },
        { "wait": 400 }
      ],
      "crops": [".column-full"]
    },
    {
      "name": "column-full-grid",
      "scenario": "states",
      "ready": ".jcard .jcard-title",
      "actions": [
        { "click": "section.column[aria-label='Complete'] .column-head" },
        { "wait": 400 }
      ],
      "crops": [".jobs-head", ".jcard"]
    },
    {
      "name": "new-modal-clips",
      "scenario": "states",
      "ready": ".wizard-modal div.clip-grid",
      "actions": [{ "click": "main.main button:has-text('New')" }],
      "crops": [".wizard-modal .wizard-head", ".wizard-modal .transient"]
    },
    {
      "name": "new-modal-configure",
      "scenario": "states",
      "ready": ".wizard-modal .rail-item",
      "actions": [
        { "click": "main.main button:has-text('New')" },
        { "click": "label.clip-card" },
        { "wait": 150 },
        { "click": ".wizard-modal button:has-text('Next: Configure')" },
        { "wait": 400 }
      ],
      "crops": [".wizard-modal .wizard-body", ".wizard-modal .rail"]
    },
    {
      "name": "review-transcript",
      "scenario": "states",
      "ready": ".detail-modal .segment",
      "actions": [
        { "click": "article.card:has-text('Status fixture: awaiting_review') .card-main" },
        { "wait": 300 },
        { "click": ".detail-modal button.tab:has-text('Review')" },
        { "wait": 400 }
      ],
      "crops": [".detail-modal .action-bar", ".detail-modal .segment"]
    },
    {
      "name": "review-upload",
      "scenario": "states",
      "promote": true,
      "ready": ".detail-modal .review-action-bar button:has-text('Submit upload')",
      "actions": [
        { "click": "article.card:has-text('Status fixture: completed') .card-main" },
        { "wait": 300 },
        { "click": ".detail-modal button.tab:has-text('Review')" },
        { "wait": 400 }
      ],
      "crops": [".detail-modal .review-action-bar", ".detail-modal .checks"]
    },
    {
      "name": "review-conversion",
      "scenario": "states",
      "promote": true,
      "ready": ".detail-modal video.review-player",
      "actions": [
        { "click": "article.card:has-text('Checkpoint fixture: awaiting_review') .card-main" },
        { "wait": 600 },
        { "click": ".detail-modal button.tab:has-text('Review')" },
        { "wait": 500 }
      ],
      "crops": [
        ".detail-modal .action-bar",
        ".review-player",
        ".detail-modal .composition-block"
      ]
    },
    {
      "name": "empty-board",
      "scenario": "empty",
      "ready": ".board section.column",
      "crops": [".jobs-head", "section.column"]
    },
    {
      "name": "empty-expanded-column",
      "scenario": "empty",
      "ready": ".column-full",
      "actions": [
        { "click": "section.column[aria-label='Complete'] .column-head" },
        { "wait": 400 }
      ],
      "crops": [".jobs-head", ".detail-modal, .column-full"]
    },
    {
      "name": "empty-metrics",
      "scenario": "empty",
      "ready": ".empty strong",
      "actions": [
        { "click": "button.menu-toggle", "onlyIfVisible": true },
        { "click": "button.nav-item:has-text('Metrics')" },
        { "wait": 400 }
      ],
      "crops": [".empty"]
    },
    {
      "name": "settings",
      "scenario": "states",
      "ready": ".content .grid-2",
      "actions": [
        { "click": "button.menu-toggle", "onlyIfVisible": true },
        { "click": "button.nav-item:has-text('Settings')" },
        { "wait": 400 }
      ],
      "crops": [".topbar", ".content"]
    },
    {
      "name": "layouts",
      "scenario": "states",
      "ready": ".content .columns",
      "actions": [
        { "click": "button.menu-toggle", "onlyIfVisible": true },
        { "click": "button.nav-item:has-text('Layouts')" },
        { "wait": 400 }
      ],
      "crops": [".topbar", ".content"]
    },
    {
      "name": "offline",
      "scenario": "states",
      "offline": true,
      "ready": ".alert[role='alert']",
      "crops": [".topbar", ".sidebar-foot", ".alert-slot"]
    }
  ]
}
